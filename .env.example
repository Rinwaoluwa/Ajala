# Copy to `.env` and adjust. Everything here is bundled into the app at build
# time, so it is PUBLIC — never put a secret in an EXPO_PUBLIC_ variable.

# The API the app talks to. Omit to use staging, which development and preview
# builds use (EAS sets it for each environment).
#   staging  https://staging-api.ajalatrvl.com   (default)
#   dev      https://dev-api.ajalatrvl.com
#   local    http://localhost:3000
# Read once at module load, so a change needs a reload, not a fast refresh.
EXPO_PUBLIC_API_URL=https://staging-api.ajalatrvl.com

# The live chat socket, on its own host (the app adds the /chat namespace).
#   staging  https://staging-ws.ajalatrvl.com
#   dev      https://dev-ws.ajalatrvl.com
# Omit it and the app guesses from the API URL by swapping its "api" host label
# for "ws" (staging-api → staging-ws, api → ws).
EXPO_PUBLIC_WS_URL=https://staging-ws.ajalatrvl.com

# Google Sign-In. The ids come from the Google Cloud project the API verifies
# ID tokens against ask the backend team; tokens minted for any other client
# are refused. Without the web client id the Google button reports that it is
# not available. The URL scheme is the iOS client id reversed, and is read at
# build time by app.config.js (a native rebuild is needed after changing it).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# The numeric App Store id, once the app is listed. The forced-update screen
# (build older than minAppVersion from GET /app/config) links to the store page;
# without this it tells iOS users to open the App Store themselves. Android's
# link comes from the package name and needs nothing here.
EXPO_PUBLIC_IOS_APP_STORE_ID=

# Share links: the app shares https://<host>/posts/{id} and /users/{id}, and
# app.config.js claims the same host (iOS applinks + webcredentials for password
# AutoFill, Android verified intent filters). One value per environment:
#   production   go.ajalatrvl.com   (default)
#   development  dev-go.ajalatrvl.com
#   staging      staging-go.ajalatrvl.com
# Read by the JavaScript and at build time; opening links needs a new native
# build, and on iOS a paid Apple Developer team.
EXPO_PUBLIC_LINKS_HOST=staging-go.ajalatrvl.com

# Google Maps for the Explore map, on both platforms. Build-time only: read by
# app.config.js, so a native rebuild is needed after changing them. The real
# values are EAS environment variables; `npx eas-cli env:pull --environment
# development` writes them (and the Google ids above) to the gitignored .env.local.
#
# The same keys also search places (Google Places API (New), src/core/places):
# app.config.js hands the platform's key to the JavaScript as extra.placesKey.
# Enable "Places API (New)" on both keys in Google Cloud. Requests name the app
# (bundle id / package + signing SHA-1); the Android key must list the debug and
# the EAS upload SHA-1s. Set GOOGLE_ANDROID_CERT_SHA1 only to send another one.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_ANDROID_CERT_SHA1=
