{
  "expo": {
    "name": "Ajala",
    "slug": "ajala",
    "scheme": "ajala",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/app-icon/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ajala.app",
      "icon": {
        "light": "./assets/images/app-icon/icon.png",
        "dark": "./assets/images/app-icon/icon-dark.png",
        "tinted": "./assets/images/app-icon/icon-tinted.png"
      },
      "appleTeamId": "B33RBL65KK"
    },
    "android": {
      "package": "com.ajala.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon/adaptive-foreground.png",
        "monochromeImage": "./assets/images/app-icon/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash/splash-wordmark.png",
          "imageWidth": 196,
          "resizeMode": "contain",
          "backgroundColor": "#0E6F69",
          "dark": {
            "image": "./assets/images/splash/splash-wordmark.png",
            "backgroundColor": "#0E6F69"
          },
          "ios": {
            "image": "./assets/images/splash/launch-ios.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#0E6F69",
            "dark": {
              "image": "./assets/images/splash/launch-ios.png",
              "backgroundColor": "#0E6F69"
            }
          },
          "android": {
            "image": "./assets/images/splash/splash-wordmark-android.png",
            "imageWidth": 168,
            "backgroundColor": "#0E6F69",
            "dark": {
              "image": "./assets/images/splash/splash-wordmark-android.png",
              "backgroundColor": "#0E6F69"
            }
          }
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ajala uses your location to show nearby activities and your position on the map.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ajala uses your photos so you can choose a profile picture.",
          "cameraPermission": "Ajala uses the camera so you can take a profile picture."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ajala uses Face ID so you can get back into the app with a glance."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "app"
      }
    }
  }
}
